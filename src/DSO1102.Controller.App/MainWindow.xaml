<Window x:Class="DSO1102.Controller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSO1102 Controller" Height="820" Width="1380"
        MinHeight="620" MinWidth="1000"
        Background="#0E1014"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171A20" BorderBrush="#343A46" BorderThickness="1" CornerRadius="6" Padding="8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Simulator verbinden" Margin="4" Padding="12,7" Click="ConnectSimulator_Click"/>
                    <Button x:Name="RunButton" Content="Run" Margin="4" Padding="12,7" Click="Run_Click" IsEnabled="False"/>
                    <Button x:Name="SingleButton" Content="Single" Margin="4" Padding="12,7" Click="Single_Click" IsEnabled="False"/>
                    <Button x:Name="StopButton" Content="Stop" Margin="4" Padding="12,7" Click="Stop_Click" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="DeviceHeaderText" Foreground="#E7EAF0" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Text="VID 04B5 / PID 1102"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#080A0E" BorderBrush="#343A46" BorderThickness="1" CornerRadius="6">
                <Canvas x:Name="ScopeCanvas" ClipToBounds="True" SizeChanged="ScopeCanvas_SizeChanged"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Border Background="#171A20" BorderBrush="#343A46" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="CH1" Foreground="#FFD84D" FontWeight="Bold"/>
                        <TextBlock x:Name="Ch1MeasurementsText" Foreground="#E7EAF0" FontFamily="Consolas" Text="—" Margin="0,4,0,12"/>
                        <TextBlock Text="CH2" Foreground="#55D7FF" FontWeight="Bold"/>
                        <TextBlock x:Name="Ch2MeasurementsText" Foreground="#E7EAF0" FontFamily="Consolas" Text="—" Margin="0,4,0,12"/>
                        <TextBlock Text="FFT CH1" Foreground="#E7EAF0" FontWeight="Bold"/>
                        <TextBlock x:Name="FftText" Foreground="#E7EAF0" FontFamily="Consolas" Text="—"/>
                    </StackPanel>
                </Border>

                <Border Background="#171A20" BorderBrush="#343A46" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="GERÄT" Foreground="#E7EAF0" FontWeight="Bold"/>
                        <TextBlock Text="DSO1102 USB DRIVER 2" Foreground="#E7EAF0" Margin="0,8,0,0"/>
                        <TextBlock Text="USB\VID_04B5&amp;PID_1102" Foreground="#AEB5C0"/>
                        <TextBlock Text="ODM" Foreground="#AEB5C0"/>
                        <TextBlock Text="Real-Backend wartet auf Treiber/API-Verifikation."
                                   Foreground="#AEB5C0" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#171A20" BorderBrush="#343A46" BorderThickness="1" CornerRadius="6" Padding="7">
            <TextBlock x:Name="StatusText" Foreground="#E7EAF0"
                       Text="Bereit. DSO-1102 Identität: VID 04B5 / PID 1102."/>
        </Border>
    </Grid>
</Window>
